<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / <a href="/solutions">Solutions</a> / Education &amp; STEM</div>
      <span class="kicker">AI-Powered Education &amp; STEM Products</span>
      <h1>Experiential, technology-driven learning</h1>
      <p>
        Vaibhava Tech develops AI-Powered EdTech products with a particular
        focus on experiential and technology-driven learning for schools,
        students and government education programs.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reveal">
        <ul class="checklist">
          <li>Artificial Intelligence</li>
          <li>Robotics</li>
          <li>Electronics</li>
          <li>Programming</li>
          <li>STEM experimentation</li>
          <li>Simulation-based learning</li>
          <li>Digital laboratories</li>
          <li>Interactive learning</li>
          <li>Assessment and evaluation</li>
        </ul>
        <div class="framed-media">
          <span class="caption">Robotics &amp; STEM Lab</span>
          <img src="/public/images/education-robotics.jpg" alt="Students building a robotics kit in a STEM lab" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center reveal">
        <span class="kicker">In the Classroom</span>
        <h2>Hands-on electronics, robotics &amp; simulation</h2>
      </div>
      <div class="gallery reveal">
        <div class="framed-media">
          <img src="/public/images/stem-snapcircuits.jpg" alt="Student learning electronics with a snap circuits kit" />
        </div>
        <div class="framed-media">
          <img src="/public/images/stem-robotkit.jpg" alt="Student assembling a 4-wheel robot kit" />
        </div>
        <div class="framed-media">
          <img src="/public/images/vision-explore.jpg" alt="Student exploring the solar system in VR" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <h2>Bring AI-powered STEM labs to your institution</h2>
        <p>
          The company aims to make advanced technology education
          accessible to schools, students, educational institutions and
          government education programs.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Request a Demo</a>
          <a href="/solutions" class="btn btn-outline">Back to Solutions</a>
        </div>
      </div>
    </div>
  </section>

  {{> footer}}
</body>
</html>
