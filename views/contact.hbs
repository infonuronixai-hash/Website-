<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / Contact</div>
      <span class="kicker">Get in Touch</span>
      <h1>Let&rsquo;s build something impactful together</h1>
      <p>
        Tell us about your requirement &mdash; AI, XR, Web, Cloud, Robotics,
        STEM or Enterprise Software &mdash; and our team will get back to
        you.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reveal" style="align-items:flex-start;">
        <div class="form-card">
          <div id="form-alert"></div>

          <form id="contact-form" method="POST" action="/api/contact">
            <div class="form-grid">
              <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required />
              </div>
              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required />
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" />
              </div>
              <div class="form-group">
                <label for="organization">Organization</label>
                <input type="text" id="organization" name="organization" />
              </div>
              <div class="form-group full">
                <label for="message">Message</label>
                <textarea id="message" name="message" required></textarea>
              </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send Enquiry</button>
          </form>
        </div>

        <div class="contact-info">
          <div class="card">
            <div class="card-icon">@</div>
            <div>
              <h3>Email Us</h3>
              <p><a href="mailto:info@vaibhavatech.com" style="color: var(--cyan); font-weight: 600;">info@vaibhavatech.com</a></p>
            </div>
          </div>
          <div class="card">
            <div class="card-icon">I</div>
            <div>
              <h3>India</h3>
              <p>Operating within one of India&rsquo;s leading technology and innovation ecosystems.</p>
            </div>
          </div>
          <div class="card">
            <div class="card-icon">S</div>
            <div>
              <h3>Solutions We Cover</h3>
              <p>AI &amp; EdTech, Agriculture, XR/AR/VR, Enterprise ERP &amp; CRM, Robotics &amp; STEM.</p>
            </div>
          </div>
          <div class="card">
            <div class="card-icon">P</div>
            <div>
              <h3>Partnerships</h3>
              <p>We work with schools, universities, government programs, industry and defence.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {{> footer}}
  <script src="/public/js/contact.js"></script>
</body>
</html>
