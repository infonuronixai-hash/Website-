<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / Team</div>
      <span class="kicker">The Team</span>
      <h1>A multidisciplinary team behind every product</h1>
      <p>
        Core technology professionals, engineers, management experts and
        domain specialists working together to conceptualize, develop and
        deploy innovative solutions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reveal">
        <div class="framed-media">
          <span class="caption">Multidisciplinary Team</span>
          <img src="/public/images/team-ai-innovation.jpg" alt="Vaibhava Tech team collaborating with AI-powered tools" />
        </div>
        <div class="prose">
          <p>
            Vaibhava Tech is supported by a multidisciplinary team of core
            technology professionals, engineers, technology specialists,
            management experts, and domain professionals who work together
            to conceptualize, develop, and deploy innovative technology
            products and solutions.
          </p>
          <p>
            Based in India, the team operates within one of the
            country&rsquo;s leading technology and innovation ecosystems,
            bringing together expertise across Artificial Intelligence,
            Extended Reality, Web Technologies, Software Engineering,
            Education Technology, Agriculture Technology, Robotics, STEM,
            Data and Digital Transformation.
          </p>
          <p>
            Our strength lies in combining deep technical capabilities with
            product thinking, business understanding and domain knowledge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center reveal">
        <span class="kicker">Areas of Expertise</span>
        <h2>What our team brings together</h2>
      </div>
      <div class="pillars reveal">
        <div class="pillar">Artificial Intelligence</div>
        <div class="pillar">Extended Reality</div>
        <div class="pillar">Web Technologies</div>
        <div class="pillar">Software Engineering</div>
        <div class="pillar">Education Technology</div>
        <div class="pillar">Agriculture Technology</div>
        <div class="pillar">Robotics</div>
        <div class="pillar">STEM</div>
        <div class="pillar">Data</div>
        <div class="pillar">Digital Transformation</div>
      </div>
    </div>
  </section>

  {{> footer}}
</body>
</html>
