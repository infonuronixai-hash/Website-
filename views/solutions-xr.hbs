<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / <a href="/solutions">Solutions</a> / Extended Reality</div>
      <span class="kicker">Extended Reality Solutions</span>
      <h1>VR, AR &amp; MR for immersive, experiential outcomes</h1>
      <p>
        Vaibhava Tech provides Extended Reality (XR) solutions and services
        across multiple sectors, including AR/VR labs for schools and
        educational institutions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reveal">
        <div class="prose">
          <h3 style="margin-top:0;">XR Capabilities</h3>
          <ul class="checklist">
            <li>Virtual Reality (VR)</li>
            <li>Augmented Reality (AR)</li>
            <li>Mixed Reality (MR)</li>
          </ul>
          <h3>Applications</h3>
          <ul class="checklist">
            <li>Defence and security</li>
            <li>Industrial training</li>
            <li>Skill development</li>
            <li>Simulation</li>
            <li>Safety training</li>
            <li>Product demonstrations</li>
            <li>Experiential learning for Agriculture universities</li>
          </ul>
        </div>
        <div class="hero-visual">
          <div class="glow-ring"></div>
          <img src="/public/images/xr-vr-woman.png" alt="Person experiencing an immersive VR environment" style="max-height:420px;" />
        </div>
      </div>

      <div class="card reveal" style="margin-top:30px;">
        <h3>AR/VR Labs for Schools</h3>
        <p>
          Vaibhava Tech develops and implements AR/VR experiential learning
          laboratories for schools and educational institutions. The
          objective is to move beyond conventional classroom learning
          towards immersive, experiential and technology-enabled education.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <h2>Bring immersive training to your organization</h2>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Talk to Us</a>
          <a href="/solutions" class="btn btn-outline">Back to Solutions</a>
        </div>
      </div>
    </div>
  </section>

  {{> footer}}
</body>
</html>
