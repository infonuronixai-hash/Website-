<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / <a href="/solutions">Solutions</a> / Enterprise Software</div>
      <span class="kicker">Enterprise Software Products</span>
      <h1>Configurable ERP &amp; CRM for every industry</h1>
      <p>
        Vaibhava Tech has expanded its product portfolio to include ERP and
        CRM solutions designed to support organizations across different
        industries.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reverse reveal">
        <div class="framed-media">
          <span class="caption">ERP &middot; CRM &middot; Analytics</span>
          <img src="/public/images/enterprise-hologram.jpg" alt="Team interacting with a holographic ERP/CRM interface" />
        </div>
        <ul class="checklist">
          <li>Business process management</li>
          <li>Customer relationship management</li>
          <li>Sales and marketing</li>
          <li>Finance and operations</li>
          <li>Human resources</li>
          <li>Project management</li>
          <li>Reporting and analytics</li>
          <li>Workflow automation</li>
        </ul>
      </div>
      <p style="margin-top:32px; color:var(--text-muted); max-width:680px;">
        The products are designed to be configurable and adaptable to the
        requirements of different industries and organizations.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <h2>Modernize your business operations</h2>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Request a Consultation</a>
          <a href="/solutions" class="btn btn-outline">Back to Solutions</a>
        </div>
      </div>
    </div>
  </section>

  {{> footer}}
</body>
</html>
