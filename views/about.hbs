<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / About</div>
      <span class="kicker">About Company</span>
      <h1>Engineering niche technology for real-world impact</h1>
      <p>
        A technology and innovation startup founded by a technology
        evangelist, building products that matter.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reverse reveal">
        <div class="framed-media">
          <span class="caption">Enterprise &amp; Innovation</span>
          <img src="/public/images/enterprise-hologram.jpg" alt="Team collaborating with a holographic ERP/CRM interface" />
        </div>
        <div class="prose">
          <p>
            Vaibhava Tech is a technology and innovation startup founded
            by a technology evangelist, with a vision to
            develop niche technology products and solutions that address
            real-world challenges across multiple sectors.
          </p>
          <p>
            The company focuses on emerging and high-impact technologies
            including Artificial Intelligence (AI), Extended Reality
            (XR)&mdash;covering Virtual Reality (VR), Augmented Reality (AR)
            and Mixed Reality (MR)&mdash;as well as Web and Cloud
            Technologies.
          </p>
          <p>
            Vaibhava Tech&rsquo;s technology portfolio is focused on
            developing innovative solutions for Agriculture, Education and
            Industry, while also providing technology-enabled services and
            customized solutions across diverse domains.
          </p>
          <a href="/team" class="btn btn-primary" style="margin-top:10px;">Meet the Team</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center reveal">
        <span class="kicker">Where We Focus</span>
        <h2>Innovation across Agriculture, Education &amp; Industry</h2>
      </div>
      <div class="grid grid-3 reveal">
        <div class="card">
          <div class="card-icon">A</div>
          <h3>Agriculture</h3>
          <p>AI-powered advisory, crop intelligence and digital agriculture solutions for farmers and institutions.</p>
        </div>
        <div class="card">
          <div class="card-icon">E</div>
          <h3>Education</h3>
          <p>AI, robotics, XR and STEM-driven experiential learning for schools and educational institutions.</p>
        </div>
        <div class="card">
          <div class="card-icon">I</div>
          <h3>Industry</h3>
          <p>Enterprise software, simulation and XR training solutions for industrial and defence applications.</p>
        </div>
      </div>
    </div>
  </section>

  {{> footer}}
</body>
</html>
