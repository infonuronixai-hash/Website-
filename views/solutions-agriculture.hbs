<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / <a href="/solutions">Solutions</a> / Agriculture</div>
      <span class="kicker">AI for Agriculture</span>
      <h1>An integrated AI Agriculture ecosystem</h1>
      <p>
        Agriculture is a strategic technology vertical for Vaibhava Tech,
        serving farmers, agricultural scientists, researchers, universities
        and extension networks.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reveal">
        <div class="framed-media">
          <span class="caption">Smart Farming with WebGL &amp; VR</span>
          <img src="/public/images/agriculture-vr.jpg" alt="Student learning agriculture with a WebGL VR crop simulator" />
        </div>
        <div class="prose">
          <h3 style="margin-top:0;">Who We Serve</h3>
          <ul class="checklist">
            <li>Farmers and agriculturists</li>
            <li>Agriculture students</li>
            <li>Agricultural scientists</li>
            <li>Researchers</li>
            <li>Agricultural universities</li>
            <li>Agricultural institutions</li>
            <li>Extension and training organizations</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center reveal">
        <span class="kicker">AI-Powered Agriculture Solutions</span>
        <h2>From advisory to digital agriculture</h2>
      </div>
      <div class="grid grid-3 reveal">
        <div class="card"><h3>AI-Based Advisory</h3><p>Crop intelligence and AI-based agricultural advisory for informed decisions.</p></div>
        <div class="card"><h3>Disease &amp; Pest ID</h3><p>Crop disease and pest identification powered by computer vision.</p></div>
        <div class="card"><h3>Research Assistance</h3><p>Agricultural research assistance and knowledge management.</p></div>
        <div class="card"><h3>AI-Powered Learning</h3><p>Virtual agriculture laboratories and AI-powered agricultural learning.</p></div>
        <div class="card"><h3>Data Analytics</h3><p>Agricultural data analytics for digital agriculture programs.</p></div>
        <div class="card"><h3>Farmer Training</h3><p>AI-enabled farmer training and extension services.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <h2>Connecting farmers, universities and researchers</h2>
        <p>
          Our long-term objective is to create an integrated AI Agriculture
          ecosystem connecting farmers, agricultural universities,
          scientists, researchers and extension networks.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Partner With Us</a>
          <a href="/solutions" class="btn btn-outline">Back to Solutions</a>
        </div>
      </div>
    </div>
  </section>

  {{> footer}}
</body>
</html>
