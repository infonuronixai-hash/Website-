<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  {{> navbar}}

  <section class="page-header">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / Solutions</div>
      <span class="kicker">Technology &amp; Product Focus</span>
      <h1>Products and solutions across seven key technology areas</h1>
      <p>
        Artificial Intelligence &amp; AI-powered applications, Extended
        Reality (XR), Web and Cloud Technologies, Enterprise Software,
        Agriculture Technology, Robotics &amp; STEM Technology, and Digital
        Simulation &amp; Immersive Learning.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2 reveal">
        <a href="/solutions/education" class="card framed-media" style="padding:0; overflow:hidden;">
          <img src="/public/images/education-robotics.jpg" alt="AI-Powered Education & STEM" style="height:220px;" />
          <div style="padding:24px; position:relative; z-index:2;">
            <h3>AI-Powered Education &amp; STEM</h3>
            <p>Experiential, technology-driven learning with AI, robotics, electronics and simulation.</p>
            <span class="card-link">Learn more &rarr;</span>
          </div>
        </a>

        <a href="/solutions/agriculture" class="card framed-media" style="padding:0; overflow:hidden;">
          <img src="/public/images/agriculture-vr.jpg" alt="AI for Agriculture" style="height:220px;" />
          <div style="padding:24px; position:relative; z-index:2;">
            <h3>AI for Agriculture</h3>
            <p>AI-based advisory, crop intelligence, disease identification and digital agriculture.</p>
            <span class="card-link">Learn more &rarr;</span>
          </div>
        </a>

        <a href="/solutions/xr" class="card framed-media" style="padding:0; overflow:hidden;">
          <img src="/public/images/xr-vr-woman.png" alt="Extended Reality Solutions" style="height:220px; object-position: top;" />
          <div style="padding:24px; position:relative; z-index:2;">
            <h3>Extended Reality Solutions</h3>
            <p>VR, AR &amp; MR for defence, industrial training, simulation and experiential learning.</p>
            <span class="card-link">Learn more &rarr;</span>
          </div>
        </a>

        <a href="/solutions/enterprise" class="card framed-media" style="padding:0; overflow:hidden;">
          <img src="/public/images/enterprise-hologram.jpg" alt="Enterprise Software Products" style="height:220px;" />
          <div style="padding:24px; position:relative; z-index:2;">
            <h3>Enterprise Software Products</h3>
            <p>Configurable ERP &amp; CRM platforms for business process management and operations.</p>
            <span class="card-link">Learn more &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <h2>Not sure which solution fits your need?</h2>
        <p>Tell us about your challenge and our team will help you find the right fit.</p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Contact Our Team</a>
        </div>
      </div>
    </div>
  </section>

  {{> footer}}
</body>
</html>
